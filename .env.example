# The extension's settings (README, "Configuration"). They reach Hindsight as the
# container's environment; never put a .env file in the image: the startup guard
# refuses one, because upstream would load it over the environment.

# The legacy key, and when it stops working (optional). Supply the key as a secret.
HINDSIGHT_API_TENANT_LEGACY_KEY=<REDACTED>
HINDSIGHT_API_TENANT_LEGACY_KEY_EXPIRES=2027-01-31
# At least 32 bytes; Agent Keys are hashed with it. Supply it as a secret.
HINDSIGHT_API_TENANT_KEY_PEPPER=<REDACTED>

# The key pages: the Cloudflare Access team URL (the JWT issuer for every Access
# application below), the key pages' Access application AUD tag, and its hostname.
HINDSIGHT_API_TENANT_ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
HINDSIGHT_API_TENANT_ACCESS_AUD=<key pages application AUD tag>
HINDSIGHT_API_TENANT_ACCESS_HOST=hindsight.example.com
AGENT_KEYS_ADMIN_EMAILS=admin@example.com

# #998: Delegated Requests (README, "Delegated Requests"). All four, and the team
# URL above, or Delegated Requests answer 404.
HINDSIGHT_API_TENANT_DELEGATION_HOST=hindsight-delegation.example.com
HINDSIGHT_API_TENANT_DELEGATION_AUD=<delegation application AUD tag>
HINDSIGHT_API_TENANT_WORKPLANE_AUD=<WorkPlane application AUD tag>
HINDSIGHT_API_TENANT_DELEGATE_CLIENT_ID=<WorkPlane service token client ID>.access

# #999: keys created via WorkPlane, per person, apart from their own 10 active and 5 an hour.
# Whole numbers; lowering the cap revokes nothing, it only refuses new keys.
HINDSIGHT_API_TENANT_WORKPLANE_ACTIVE_KEYS=25
HINDSIGHT_API_TENANT_WORKPLANE_KEYS_PER_HOUR=25
